<!--
AgValoniaGPS
Copyright (C) 2024-2025 AgValoniaGPS Contributors

TractorPage — mini-AppShell with its own bottom sub-tab bar.

Sub-tabs:
  • Dimensions       (Vehicle Type + Geometry + Antenna — current content)
  • U-Turn           (placeholder)
  • Machine Control  (placeholder)
  • Tram Lines       (placeholder)
  • GPS / Data Sources (placeholder)

Sub-tab styling mirrors AppShell's TabLabel + TabIndicator look so the
whole app feels consistent: same accent underline, same hover, same
spacing. Code-behind in TractorPage.axaml.cs handles sub-tab clicks
and content swap (identical pattern to AppShell).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgValoniaGPS.ViewModels"
             xmlns:conv="using:AgValoniaGPS.Views.Converters"
             xmlns:controls="using:AgValoniaGPS.Views.Controls"
             xmlns:config="using:AgValoniaGPS.Views.Controls.Dialogs.Configuration"
             x:Class="AgValoniaGPS.Views.Controls.Pages.TractorPage"
             x:DataType="vm:ConfigurationViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Styles>
        <!-- Section + content styles for Dimensions sub-tab -->
        <Style Selector="Border.Section">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="TextBlock.SectionHeading">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource LabelTextBrush}"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
        </Style>
        <!-- Thin rounded pill that sits under each section heading to
             group related items without a full card border. Same color
             as the v1 card border, just rendered as a 2px line. -->
        <Style Selector="Border.SectionLine">
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style Selector="TextBlock.FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style Selector="Button.VehicleType">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.VehicleType:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>

        <!-- Bottom sub-tab bar styling — mirrors AppShell's TabLabel + TabIndicator -->
        <Style Selector="Button.SubTabLabel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style Selector="Button.SubTabLabel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="Button.SubTabLabel:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.SubTabLabel.Active">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.SubTabLabel.Active /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.SubTabIndicator">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="StackPanel.SubTabItem.Active > Border.SubTabIndicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Placeholder content for sub-tabs not yet built -->
        <Style Selector="TextBlock.PlaceholderHeading">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.PlaceholderSub">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">

        <!-- Tractor heading is folded into the Dimensions sub-tab's Vehicle
             Type column to reclaim a full row of vertical space. Edit
             Layout toggle + readout live there too (only relevant on
             Dimensions). -->

        <!-- ============= SUB-TAB CONTENT (one visible at a time) ============= -->
        <Grid Grid.Row="0" Margin="20,20,20,0">

            <!-- ===== Dimensions (default) =====
                 Free-canvas layout: every section card is positioned by
                 absolute Margin so the dev Edit-Layout mode can drag any
                 of them (in addition to the value boxes inside). The
                 outer Grid is fixed-size so percentages of the canvas
                 translate cleanly to Margin pixels. -->
            <ScrollViewer x:Name="SectionDimensions" IsVisible="True"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <Viewbox Stretch="Uniform">
                <Grid x:Name="DimensionsCanvas"
                      Width="1100" Height="640"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <!-- LEFT: Tractor · profile header + Vehicle Type stack -->
                    <StackPanel x:Name="VehicleTypeCard"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="0,0,0,0"
                                Width="200"
                                Spacing="10">
                            <!-- Page identifier — replaces the dedicated header row -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Tractor"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Config.ActiveVehicleProfileName}"
                                           FontSize="14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Classes="SectionLine"/>
                            <Button Classes="VehicleType"
                                    Command="{Binding SetVehicleTypeCommand}"
                                    CommandParameter="Harvester"
                                    BorderBrush="{Binding Vehicle.Type, Converter={x:Static conv:EnumToSelectionBrushConverter.Instance}, ConverterParameter=Harvester}">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/vehiclePageHarvester.png"
                                           Width="56" Height="42" Stretch="Uniform"/>
                                    <TextBlock Text="Harvester"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="VehicleType"
                                    Command="{Binding SetVehicleTypeCommand}"
                                    CommandParameter="Tractor"
                                    BorderBrush="{Binding Vehicle.Type, Converter={x:Static conv:EnumToSelectionBrushConverter.Instance}, ConverterParameter=Tractor}">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/vehiclePageTractor.png"
                                           Width="56" Height="42" Stretch="Uniform"/>
                                    <TextBlock Text="Tractor"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="VehicleType"
                                    Command="{Binding SetVehicleTypeCommand}"
                                    CommandParameter="FourWD"
                                    BorderBrush="{Binding Vehicle.Type, Converter={x:Static conv:EnumToSelectionBrushConverter.Instance}, ConverterParameter=FourWD}">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/vehiclePageArticulated.png"
                                           Width="56" Height="42" Stretch="Uniform"/>
                                    <TextBlock Text="Articulated"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- DEV: drag-to-position toggle + readout. -->
                            <ToggleButton x:Name="EditLayoutToggle"
                                          Content="✎ Edit Layout"
                                          IsCheckedChanged="OnEditLayoutToggleChanged"
                                          FontSize="12"
                                          Padding="10,6"
                                          HorizontalAlignment="Stretch"
                                          Margin="0,8,0,0"/>
                            <TextBlock x:Name="LayoutReadout"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Geometry section heading — independently draggable -->
                    <StackPanel x:Name="GeometryHeader"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="220,0,0,0"
                                Width="780"
                                Background="Transparent">
                        <TextBlock Classes="SectionHeading" Text="GEOMETRY"/>
                        <Border Classes="SectionLine"/>
                    </StackPanel>

                    <!-- RIGHT TOP: Geometry diagram -->
                    <StackPanel x:Name="GeometryCard"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="220,32,0,0"
                                Width="780">
                        <Grid Width="720"
                              Height="280"
                              HorizontalAlignment="Center">
                                <!-- Locked positions (readout 2026-05-14, third pass):
                                     diag (18%,0%) · hitch (3%,35%) · track (69%,23%) ·
                                     wheelbase (24%,69%). Container 720×280. -->
                                <Image x:Name="WheelbaseDiagramImage"
                                       Source="{Binding Vehicle.WheelbaseDiagramImageSource, Converter={x:Static conv:StringToImageConverter.Instance}}"
                                       Stretch="Uniform"
                                       Width="720" Height="280"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="130,0,0,0"/>
                                <StackPanel x:Name="HitchLengthBox"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="22,98,0,0">
                                    <controls:EditableNumericField
                                        Value="{Binding Tool.HitchLength, Mode=TwoWay}"
                                        Unit="m" FormatString="F2"
                                        EditCommand="{Binding EditHitchLengthCommand}"/>
                                    <TextBlock Text="Hitch Length" Classes="FieldLabel"/>
                                </StackPanel>
                                <StackPanel x:Name="TrackBox"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="497,64,0,0">
                                    <controls:EditableNumericField
                                        Value="{Binding Vehicle.TrackWidth, Mode=TwoWay}"
                                        Unit="m" FormatString="F2"
                                        EditCommand="{Binding EditTrackWidthCommand}"/>
                                    <TextBlock Text="Track" Classes="FieldLabel"/>
                                </StackPanel>
                                <StackPanel x:Name="WheelbaseBox"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="173,193,0,0">
                                    <controls:EditableNumericField
                                        Value="{Binding Vehicle.Wheelbase, Mode=TwoWay}"
                                        Unit="m" FormatString="F2"
                                        EditCommand="{Binding EditWheelbaseCommand}"/>
                                    <TextBlock Text="Wheelbase" Classes="FieldLabel"/>
                                </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Antenna section heading — independently draggable.
                         Locked position from readout 2026-05-14: (20%, 46%) → 220,294 -->
                    <StackPanel x:Name="AntennaHeader"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="220,294,0,0"
                                Width="780"
                                Background="Transparent">
                        <TextBlock Classes="SectionHeading" Text="ANTENNA"/>
                        <Border Classes="SectionLine"/>
                    </StackPanel>

                    <!-- RIGHT BOTTOM: Antenna diagrams -->
                    <StackPanel x:Name="AntennaCard"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="220,292,0,0"
                                Width="780">
                        <Grid Width="720"
                              Height="345"
                              HorizontalAlignment="Center">
                                <!-- Locked positions (readout 2026-05-14, third pass):
                                     side-view (-7%,29%) · rear-view (51%,5%) ·
                                     pivot (-3%,12%) · height (34%,43%) · offset (83%,34%).
                                     Container 720×345. -->
                                <Image x:Name="SideViewImage"
                                       Source="{Binding Vehicle.AntennaTopImageSource, Converter={x:Static conv:StringToImageConverter.Instance}}"
                                       Stretch="Uniform"
                                       Width="360" Height="345"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="-50,100,0,0"/>
                                <Image x:Name="RearViewImage"
                                       Source="{Binding Vehicle.AntennaOffsetImageSource, Converter={x:Static conv:StringToImageConverter.Instance}}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="367,31,0,0"/>
                                <StackPanel x:Name="PivotDistanceBox"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="-22,41,0,0">
                                    <controls:EditableNumericField
                                        Value="{Binding Vehicle.AntennaPivot, Mode=TwoWay}"
                                        Unit="m" FormatString="F2"
                                        EditCommand="{Binding EditAntennaPivotCommand}"/>
                                    <TextBlock Text="Pivot Distance" Classes="FieldLabel"/>
                                </StackPanel>
                                <StackPanel x:Name="AntennaHeightBox"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="245,148,0,0">
                                    <controls:EditableNumericField
                                        Value="{Binding Vehicle.AntennaHeight, Mode=TwoWay}"
                                        Unit="m" FormatString="F2"
                                        EditCommand="{Binding EditAntennaHeightCommand}"/>
                                    <TextBlock Text="Antenna Height" Classes="FieldLabel"/>
                                </StackPanel>
                                <StackPanel x:Name="AntennaOffsetBox"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="598,117,0,0">
                                    <controls:EditableNumericField
                                        Value="{Binding Vehicle.AntennaOffset, Mode=TwoWay}"
                                        Unit="m" FormatString="F2"
                                        EditCommand="{Binding EditAntennaOffsetCommand}"/>
                                    <TextBlock Text="Antenna Offset" Classes="FieldLabel"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,6,0,0"
                                                HorizontalAlignment="Center">
                                        <Button Width="40" Height="30" Padding="4"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                ToolTip.Tip="Antenna Left of Center"
                                                Command="{Binding SetAntennaOffsetLeftCommand}">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/AntennaLeftOffset.png" Stretch="Uniform"/>
                                        </Button>
                                        <Button Width="40" Height="30" Padding="4"
                                                Background="{DynamicResource AccentBrush}"
                                                ToolTip.Tip="Antenna on Centerline"
                                                Command="{Binding SetAntennaOffsetCenterCommand}">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/AntennaNoOffset.png" Stretch="Uniform"/>
                                        </Button>
                                        <Button Width="40" Height="30" Padding="4"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                ToolTip.Tip="Antenna Right of Center"
                                                Command="{Binding SetAntennaOffsetRightCommand}">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/AntennaRightOffset.png" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
                </Viewbox>
            </ScrollViewer>

            <!-- ===== U-Turn / Tram Lines — cardless ===== -->
            <ScrollViewer x:Name="SectionUTurnTramLines" IsVisible="False">
                <StackPanel Margin="0,12,0,0">

                    <TextBlock Classes="SectionHeading" Text="U-TURN" Margin="4,0,0,0"/>
                    <Border Classes="SectionLine"/>

                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                        <StackPanel Margin="8" Spacing="8" HorizontalAlignment="Center">
                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConU_UturnLength.png"
                                   Stretch="Uniform" Height="84"/>
                            <controls:EditableNumericField HorizontalAlignment="Center"
                                Value="{Binding Guidance.UTurnExtension, Mode=TwoWay}"
                                Unit="m" FormatString="F1"
                                EditCommand="{Binding EditUTurnExtensionCommand}"/>
                            <TextBlock Text="Extension Length" Classes="FieldLabel"/>
                        </StackPanel>
                        <StackPanel Margin="8" Spacing="8" HorizontalAlignment="Center">
                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConU_UturnSmooth.png"
                                   Stretch="Uniform" Height="84"/>
                            <controls:EditableNumericField HorizontalAlignment="Center"
                                Value="{Binding Guidance.UTurnSmoothing, Mode=TwoWay}"
                                Unit="" FormatString="F0"
                                EditCommand="{Binding EditUTurnSmoothingCommand}"/>
                            <TextBlock Text="Smoothing" Classes="FieldLabel"/>
                        </StackPanel>
                        <StackPanel Margin="8" Spacing="8" HorizontalAlignment="Center">
                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConU_UturnRadius.png"
                                   Stretch="Uniform" Height="84"/>
                            <controls:EditableNumericField HorizontalAlignment="Center"
                                Value="{Binding Guidance.UTurnRadius, Mode=TwoWay}"
                                Unit="m" FormatString="F2"
                                EditCommand="{Binding EditUTurnRadiusCommand}"/>
                            <TextBlock Text="Turn Radius" Classes="FieldLabel"/>
                        </StackPanel>
                        <StackPanel Margin="8" Spacing="8" HorizontalAlignment="Center">
                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConU_UturnDistance.png"
                                   Stretch="Uniform" Height="84"/>
                            <controls:EditableNumericField HorizontalAlignment="Center"
                                Value="{Binding Guidance.UTurnDistanceFromBoundary, Mode=TwoWay}"
                                Unit="m" FormatString="F2"
                                EditCommand="{Binding EditUTurnDistanceCommand}"/>
                            <TextBlock Text="Trigger Distance" Classes="FieldLabel"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Classes="SectionHeading" Text="TRAM LINES" Margin="4,0,0,0"/>
                    <Border Classes="SectionLine"/>

                    <UniformGrid Rows="1" Columns="3">
                        <StackPanel Margin="8" Spacing="8" HorizontalAlignment="Center">
                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConT_TramOverride.png"
                                   Stretch="Uniform" Height="84"/>
                            <controls:EditableNumericField HorizontalAlignment="Center"
                                Value="{Binding Guidance.TramPasses, Mode=TwoWay}"
                                Unit="" FormatString="F0"
                                EditCommand="{Binding EditTramPassesCommand}"/>
                            <TextBlock Text="Passes" Classes="FieldLabel"/>
                        </StackPanel>
                        <StackPanel Margin="8" Spacing="8" HorizontalAlignment="Center">
                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConT_TramOverrideDisplay.png"
                                   Stretch="Uniform" Height="84"/>
                            <Button Background="{Binding Guidance.TramDisplay, Converter={x:Static conv:BoolToToggleBackgroundConverter.Instance}}"
                                    BorderBrush="{Binding Guidance.TramDisplay, Converter={x:Static conv:BoolToToggleBorderConverter.Instance}}"
                                    BorderThickness="1" CornerRadius="4" Padding="14,8" Cursor="Hand"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ToggleTramDisplayCommand}"
                                    Content="{Binding Guidance.TramDisplay, Converter={x:Static conv:BoolToStringConverter.Instance}, ConverterParameter='ON|OFF'}"/>
                            <TextBlock Text="Display" Classes="FieldLabel"/>
                        </StackPanel>
                        <StackPanel Margin="8" Spacing="8" HorizontalAlignment="Center">
                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConT_TramSpacing.png"
                                   Stretch="Uniform" Height="84"/>
                            <controls:EditableNumericField HorizontalAlignment="Center"
                                Value="{Binding Guidance.TramLine, Mode=TwoWay}"
                                Unit="" FormatString="F0"
                                EditCommand="{Binding EditTramLineCommand}"/>
                            <TextBlock Text="Tram Line" Classes="FieldLabel"/>
                        </StackPanel>
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== Machine Control — Machine Module + Pin Config combined.
                 Canvas-style layout: three positioned blocks (MachineModuleBlock,
                 PinConfigBlock, ActionsBlock) registered with the drag-to-position
                 dev mode so they can be rearranged via the Edit Layout toggle. -->
            <Viewbox x:Name="SectionMachineControl" IsVisible="False"
                     Stretch="Uniform">
            <Grid Width="1100" Height="570"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">

                <!-- MACHINE MODULE — individually draggable controls.
                     Toggle is declared LAST in the Grid (below) so it renders
                     on top of any draggable headers whose Background="Transparent"
                     would otherwise swallow the click. -->
                <StackPanel x:Name="MachineModuleHeader"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="0,0,0,0" Width="1100"
                            Background="Transparent">
                    <TextBlock Classes="SectionHeading" Text="MACHINE MODULE" Margin="4,0,0,0"/>
                    <Border Classes="SectionLine"/>
                </StackPanel>

                <StackPanel x:Name="MM_Enable"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="0,40,0,0"
                            Spacing="4" Background="Transparent">
                    <TextBlock Text="Enable" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <Button Background="{Binding Machine.HydraulicLiftEnabled, Converter={x:Static conv:BoolToToggleBackgroundConverter.Instance}}"
                            BorderBrush="{Binding Machine.HydraulicLiftEnabled, Converter={x:Static conv:BoolToToggleBorderConverter.Instance}}"
                            BorderThickness="1" CornerRadius="4" Cursor="Hand"
                            Command="{Binding ToggleHydraulicLiftCommand}"
                            Width="70" Height="70">
                        <TextBlock Text="⏻" FontSize="28" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="MM_RaiseTime"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="176,40,0,0" Spacing="4" Background="Transparent">
                    <TextBlock Text="Raise Time" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <controls:EditableNumericField HorizontalAlignment="Center"
                        Value="{Binding Machine.RaiseTime, Mode=TwoWay}"
                        Unit="" FormatString="F0"
                        EditCommand="{Binding EditRaiseTimeCommand}"/>
                    <TextBlock Text="Plant Pop" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>

                <Image x:Name="MM_RaiseImage"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="308,46,0,0"
                       Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConMa_LiftRaiseTime.png"
                       Stretch="Uniform" Height="84"/>

                <StackPanel x:Name="MM_LookAhead"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="176,217,0,0" Spacing="4" Background="Transparent">
                    <TextBlock Text="Look Ahead" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <controls:EditableNumericField HorizontalAlignment="Center"
                        Value="{Binding Machine.LookAhead, Mode=TwoWay}"
                        Unit="" FormatString="F1"
                        EditCommand="{Binding EditLookAheadCommand}"/>
                </StackPanel>

                <StackPanel x:Name="MM_LowerTime"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="176,142,0,0" Spacing="4" Background="Transparent">
                    <TextBlock Text="Lower Time" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <controls:EditableNumericField HorizontalAlignment="Center"
                        Value="{Binding Machine.LowerTime, Mode=TwoWay}"
                        Unit="" FormatString="F0"
                        EditCommand="{Binding EditLowerTimeCommand}"/>
                </StackPanel>

                <Image x:Name="MM_LowerImage"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="297,142,0,0"
                       Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConMa_LiftLowerTime.png"
                       Stretch="Uniform" Height="84"/>

                <StackPanel x:Name="MM_InvertRelay"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="0,148,0,0" Spacing="4" Background="Transparent">
                    <TextBlock Text="Invert Relay" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                    <Button Background="{Binding Machine.InvertRelay, Converter={x:Static conv:BoolToToggleBackgroundConverter.Instance}}"
                            BorderBrush="{Binding Machine.InvertRelay, Converter={x:Static conv:BoolToToggleBorderConverter.Instance}}"
                            BorderThickness="1" CornerRadius="4" Cursor="Hand"
                            Command="{Binding ToggleInvertRelayCommand}"
                            HorizontalAlignment="Left" Width="120" Height="60">
                        <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Config/ConSt_InvertRelay.png"
                               Width="80" Height="40" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <StackPanel x:Name="MM_User1"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="594,34,0,0" Spacing="2" Background="Transparent" Width="100">
                    <TextBlock Text="User 1" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <controls:EditableNumericField HorizontalAlignment="Stretch"
                        Value="{Binding Machine.User1Value, Mode=TwoWay}"
                        Unit="" FormatString="F0"
                        EditCommand="{Binding EditUser1Command}"/>
                </StackPanel>

                <StackPanel x:Name="MM_User2"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="594,96,0,0" Spacing="2" Background="Transparent" Width="100">
                    <TextBlock Text="User 2" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <controls:EditableNumericField HorizontalAlignment="Stretch"
                        Value="{Binding Machine.User2Value, Mode=TwoWay}"
                        Unit="" FormatString="F0"
                        EditCommand="{Binding EditUser2Command}"/>
                </StackPanel>

                <StackPanel x:Name="MM_User3"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="594,159,0,0" Spacing="2" Background="Transparent" Width="100">
                    <TextBlock Text="User 3" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <controls:EditableNumericField HorizontalAlignment="Stretch"
                        Value="{Binding Machine.User3Value, Mode=TwoWay}"
                        Unit="" FormatString="F0"
                        EditCommand="{Binding EditUser3Command}"/>
                </StackPanel>

                <StackPanel x:Name="MM_User4"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="594,222,0,0" Spacing="2" Background="Transparent" Width="100">
                    <TextBlock Text="User 4" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center"/>
                    <controls:EditableNumericField HorizontalAlignment="Stretch"
                        Value="{Binding Machine.User4Value, Mode=TwoWay}"
                        Unit="" FormatString="F0"
                        EditCommand="{Binding EditUser4Command}"/>
                </StackPanel>

                <!-- PIN CONFIG block -->
                <StackPanel x:Name="PinConfigBlock"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="0,290,0,0"
                            Width="1100"
                            Spacing="10"
                            Background="Transparent">
                    <TextBlock Classes="SectionHeading" Text="PIN CONFIG" Margin="4,0,0,0"/>
                    <Border Classes="SectionLine"/>
                    <UniformGrid Columns="8" Rows="3">
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 1" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin1Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 2" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin2Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 3" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin3Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 4" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin4Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 5" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin5Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 6" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin6Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 7" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin7Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 8" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin8Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 9" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin9Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 10" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin10Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 11" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin11Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 12" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin12Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 13" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin13Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 14" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin14Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 15" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin15Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 16" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin16Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 17" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin17Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 18" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin18Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 19" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin19Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 20" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin20Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 21" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin21Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 22" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin22Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 23" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin23Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Margin="4">
                                <TextBlock Text="Pin 24" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PinFunctionOptions}" SelectedItem="{Binding Pin24Function}" HorizontalAlignment="Stretch" FontSize="11"/>
                            </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <!-- ACTIONS block — single Send+Save for the whole page -->
                <Grid x:Name="ActionsBlock"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="0,518,0,0"
                      Width="1100"
                      ColumnDefinitions="Auto,Auto,*,Auto"
                      Background="Transparent">
                    <Button Grid.Column="0" Padding="14,10" Cursor="Hand"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            Command="{Binding ResetPinConfigCommand}"
                            ToolTip.Tip="Reset Pin Config">
                        <TextBlock Text="↺" FontSize="20" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Button>
                    <Button Grid.Column="1" Padding="14,10" Cursor="Hand" Margin="8,0,0,0"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            Command="{Binding UploadPinConfigCommand}"
                            ToolTip.Tip="Upload Pin Config">
                        <TextBlock Text="↑" FontSize="20" Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                    <Button Grid.Column="3" Padding="18,10" Cursor="Hand"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Command="{Binding SendAndSaveMachineConfigCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Send + Save" VerticalAlignment="Center"/>
                            <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="→" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Per-section Edit Layout toggle + readout. Declared LAST
                     so it renders on top of any draggable headers that
                     would otherwise swallow its clicks. Shares state with
                     the Dimensions toggle via OnEditLayoutToggleChanged. -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                            Orientation="Horizontal" Spacing="12">
                    <TextBlock x:Name="MachineControlLayoutReadout"
                               Text=""
                               FontSize="11"
                               Foreground="{DynamicResource AccentBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="700"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                    <ToggleButton x:Name="MachineControlEditToggle"
                                  Content="✎ Edit Layout"
                                  IsCheckedChanged="OnEditLayoutToggleChanged"
                                  FontSize="12"
                                  Padding="10,6"/>
                </StackPanel>
            </Grid>
            </Viewbox>

            <!-- ===== GPS / Data Sources — embeds existing SourcesConfigTab ===== -->
            <config:SourcesConfigTab x:Name="SectionGps" IsVisible="False"/>
        </Grid>

        <!-- ============= BOTTOM SUB-TAB BAR ============= -->
        <Border Grid.Row="1"
                Background="{DynamicResource ChromeStripBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,4">
            <StackPanel x:Name="SubTabBar"
                        Orientation="Horizontal"
                        Spacing="0"
                        HorizontalAlignment="Center">

                <!-- Home: navigates away from the Tractor page; styled
                     identically to the other sub-tab buttons. -->
                <StackPanel Classes="SubTabItem" Margin="6,0">
                    <Button Classes="SubTabLabel" Content="HOME"
                            Click="OnHomeClicked"/>
                    <Border Classes="SubTabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabDimensions" Classes="SubTabItem Active" Margin="6,0">
                    <Button Classes="SubTabLabel" Content="DIMENSIONS"
                            Click="OnSubTabClicked" Tag="Dimensions"/>
                    <Border Classes="SubTabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabUTurnTramLines" Classes="SubTabItem" Margin="6,0">
                    <Button Classes="SubTabLabel" Content="U-TURN / TRAM LINES"
                            Click="OnSubTabClicked" Tag="UTurnTramLines"/>
                    <Border Classes="SubTabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabMachineControl" Classes="SubTabItem" Margin="6,0">
                    <Button Classes="SubTabLabel" Content="MACHINE CONTROL"
                            Click="OnSubTabClicked" Tag="MachineControl"/>
                    <Border Classes="SubTabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabGps" Classes="SubTabItem" Margin="6,0">
                    <Button Classes="SubTabLabel" Content="GPS / DATA SOURCES"
                            Click="OnSubTabClicked" Tag="Gps"/>
                    <Border Classes="SubTabIndicator"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
