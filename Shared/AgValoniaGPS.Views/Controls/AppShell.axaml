<!--
AgValoniaGPS
Copyright (C) 2024-2025 AgValoniaGPS Contributors

AppShell — the v2 application chrome. Hosts a top status strip, the
page content area, and a bottom tab bar. See Plans/PageBasedNavigation
for design notes; DashboardTheme.axaml provides every chrome brush.

PoC state: tabs are real Buttons with click handlers in the
code-behind that swap the page content. Default page = HomePage.
Non-Home tabs show inline placeholder text for now.

Wired bindings to a NavigationService come in a follow-up; this lets
us see and judge the look before plumbing the real navigation.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="using:AgValoniaGPS.Models.Navigation"
             xmlns:vm="using:AgValoniaGPS.ViewModels"
             x:Class="AgValoniaGPS.Views.Controls.AppShell"
             x:DataType="vm:MainViewModel">
    <!-- No Background on the UserControl root: when the FullChrome Grid
         is hidden on MovingMap, pointer events fall through to the v1
         map+panels layout underneath. -->


    <UserControl.Styles>
        <!-- Tab button: text label, transparent background, no border. Active
             state is set via the `.Active` class by the code-behind. -->
        <Style Selector="Button.TabLabel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <!-- Hover + press states must target the ContentPresenter level
             that Fluent's own button template uses, otherwise Fluent's
             :pointerover Foreground override (which resolves to a dark
             color on dark themes) wins and the label flips to black. -->
        <Style Selector="Button.TabLabel:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="Button.TabLabel:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.TabLabel.Active">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Button.TabLabel.Active /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Active-tab underline indicator. Lives inside the tab's Grid so
             it positions directly under the label, only visible when its
             parent has the .Active class. -->
        <Style Selector="Border.TabIndicator">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="StackPanel.TabItem.Active > Border.TabIndicator">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Top status strip text — small, dim by default, primary when it's
             actually showing data. -->
        <Style Selector="TextBlock.StatusText">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.StatusText.Strong">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <Panel>

    <!-- ============= FULL CHROME (top strip + page + tab bar) =============
         Hidden when CurrentPage == MovingMap so the v1 map+panels layout
         underneath shows through. -->
    <Grid x:Name="FullChrome"
          IsVisible="{Binding IsNotMovingMapPage}"
          Background="{DynamicResource AppBackgroundBrush}"
          RowDefinitions="Auto,*,Auto">

        <!-- ============= TOP STATUS STRIP =============
             Left: fix-quality dot + text + satellite count + G/I/A/M
             module indicators (each letter colored by the matching
             IsXxxDataOk state via BoolToColorConverter).
             Right: current date (secondary) + current time (strong).
             Chrome brushes only; data accent colors come from the
             value-converters, not hardcoded hex. -->
        <Border Grid.Row="0"
                Background="{DynamicResource ChromeStripBackgroundBrush}"
                Padding="20,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10"
                             VerticalAlignment="Center"
                             Fill="{Binding State.Vehicle.FixQualityText, Converter={StaticResource FixQualityToColorConverter}}"/>
                    <TextBlock Classes="StatusText Strong"
                               Text="{Binding State.Vehicle.FixQualityText}"/>
                    <TextBlock Classes="StatusText" Text="·"/>
                    <TextBlock Classes="StatusText"
                               Text="{Binding State.Vehicle.SatelliteCount, StringFormat='{}{0} sats'}"/>
                    <!-- Thin separator before module indicators -->
                    <Rectangle Width="1" Height="14" Margin="6,0"
                               Fill="{DynamicResource CardBorderBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontSize="14" FontWeight="Bold" Text="G"
                                   Foreground="{Binding State.Connections.IsGpsDataOk, Converter={StaticResource BoolToColorConverter}}"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Text="I"
                                   Foreground="{Binding State.Connections.IsImuDataOk, Converter={StaticResource BoolToColorConverter}}"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Text="A"
                                   Foreground="{Binding State.Connections.IsAutoSteerDataOk, Converter={StaticResource BoolToColorConverter}}"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Text="M"
                                   Foreground="{Binding State.Connections.IsMachineDataOk, Converter={StaticResource BoolToColorConverter}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center">
                    <TextBlock Classes="StatusText" Text="{Binding CurrentDate}"/>
                    <TextBlock Classes="StatusText Strong" Text="{Binding CurrentTime}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============= PAGE CONTENT AREA ============= -->
        <ContentControl Grid.Row="1"
                        x:Name="PageContent"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource AppBackgroundBrush}"/>

        <!-- ============= BOTTOM TAB BAR ============= -->
        <Border Grid.Row="2"
                Background="{DynamicResource ChromeStripBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <StackPanel x:Name="TabBar"
                        Orientation="Horizontal"
                        Spacing="0"
                        HorizontalAlignment="Center">

                <StackPanel x:Name="TabHome" Classes="TabItem Active" Margin="6,0"
                            Tag="{x:Static nav:PageType.Home}">
                    <Button Classes="TabLabel" Content="HOME"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="{x:Static nav:PageType.Home}"/>
                    <Border Classes="TabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabOperator" Classes="TabItem" Margin="6,0"
                            Tag="{x:Static nav:PageType.OperatorProfile}">
                    <Button Classes="TabLabel" Content="OPERATOR"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="{x:Static nav:PageType.OperatorProfile}"/>
                    <Border Classes="TabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabTractor" Classes="TabItem" Margin="6,0"
                            Tag="{x:Static nav:PageType.Tractor}">
                    <Button Classes="TabLabel" Content="TRACTOR"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="{x:Static nav:PageType.Tractor}"/>
                    <Border Classes="TabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabImplement" Classes="TabItem" Margin="6,0"
                            Tag="{x:Static nav:PageType.Implement}">
                    <Button Classes="TabLabel" Content="IMPLEMENT"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="{x:Static nav:PageType.Implement}"/>
                    <Border Classes="TabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabFieldsJobs" Classes="TabItem" Margin="6,0"
                            Tag="{x:Static nav:PageType.FieldsAndJobs}">
                    <Button Classes="TabLabel" Content="FIELDS &amp; JOBS"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="{x:Static nav:PageType.FieldsAndJobs}"/>
                    <Border Classes="TabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabMap" Classes="TabItem" Margin="6,0"
                            Tag="{x:Static nav:PageType.MovingMap}">
                    <Button Classes="TabLabel" Content="MAP"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="{x:Static nav:PageType.MovingMap}"/>
                    <Border Classes="TabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabNtrip" Classes="TabItem" Margin="6,0"
                            Tag="{x:Static nav:PageType.NtripNetworking}">
                    <Button Classes="TabLabel" Content="NTRIP"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="{x:Static nav:PageType.NtripNetworking}"/>
                    <Border Classes="TabIndicator"/>
                </StackPanel>

                <StackPanel x:Name="TabSettings" Classes="TabItem" Margin="6,0"
                            Tag="{x:Static nav:PageType.ApplicationSettings}">
                    <Button Classes="TabLabel" Content="SETTINGS"
                            Command="{Binding NavigateToPageCommand}"
                            CommandParameter="{x:Static nav:PageType.ApplicationSettings}"/>
                    <Border Classes="TabIndicator"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- ============= FLOATING HOME BUTTON =============
         Visible only on the MovingMap page. Tapping it disengages
         autosteer (via NavigationService guardrail) and returns to Home.
         Top-left placement per Plans/PageBasedNavigation/PLAN.md §Moving Map. -->
    <Button IsVisible="{Binding IsMovingMapPage}"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="16"
            Padding="14,8"
            Content="← HOME"
            FontSize="14"
            FontWeight="SemiBold"
            Command="{Binding GoHomeCommand}"
            Background="{DynamicResource ChromeStripBackgroundBrush}"
            Foreground="{DynamicResource PrimaryTextBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"/>

    </Panel>
</UserControl>
