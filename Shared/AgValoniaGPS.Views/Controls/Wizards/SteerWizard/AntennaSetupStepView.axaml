<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:steer="clr-namespace:AgValoniaGPS.ViewModels.Wizards.SteerWizard;assembly=AgValoniaGPS.ViewModels"
             xmlns:conv="using:AgValoniaGPS.Views.Converters"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="600"
             x:Class="AgValoniaGPS.Views.Controls.Wizards.SteerWizard.AntennaSetupStepView"
             x:DataType="steer:AntennaSetupStepViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                   Margin="0,0,0,12"/>

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Description}"
                   FontSize="14"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                   TextWrapping="Wrap"
                   LineHeight="22"
                   Margin="0,0,0,24"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- Antenna diagram -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="8"
                        Padding="20"
                        HorizontalAlignment="Center">
                    <Image Source="{Binding AntennaIconSource, Converter={x:Static conv:StringToImageConverter.Instance}}"
                           Width="200" Height="120"
                           Stretch="Uniform"/>
                </Border>

                <!-- Antenna Pivot -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12"
                        Padding="24,16"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Pivot Distance"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="Antenna to rear axle (+ = ahead)"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumericUpDown Value="{Binding AntennaPivot}"
                                           Minimum="-10"
                                           Maximum="15"
                                           Increment="0.05"
                                           FormatString="F2"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Width="130"
                                           HorizontalContentAlignment="Center"
                                           Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                           BorderThickness="2"
                                           CornerRadius="8"/>
                            <TextBlock Text="m"
                                       FontSize="18"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Antenna Height -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12"
                        Padding="24,16"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Height"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="Antenna above ground"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumericUpDown Value="{Binding AntennaHeight}"
                                           Minimum="0"
                                           Maximum="10"
                                           Increment="0.05"
                                           FormatString="F2"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Width="130"
                                           HorizontalContentAlignment="Center"
                                           Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                           BorderThickness="2"
                                           CornerRadius="8"/>
                            <TextBlock Text="m"
                                       FontSize="18"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Antenna Offset -->
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12"
                        Padding="24,16"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Lateral Offset"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock Text="From centerline (+ = right)"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <NumericUpDown Value="{Binding AntennaOffset}"
                                           Minimum="-5"
                                           Maximum="5"
                                           Increment="0.05"
                                           FormatString="F2"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Width="130"
                                           HorizontalContentAlignment="Center"
                                           Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                           BorderThickness="2"
                                           CornerRadius="8"/>
                            <TextBlock Text="m"
                                       FontSize="18"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Offset direction quick buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Button Content="Left"
                            Command="{Binding SetLeftCommand}"
                            Width="80" Height="36"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                            CornerRadius="6"
                            HorizontalContentAlignment="Center"
                            Classes.selected="{Binding IsLeft}"/>
                    <Button Content="Center"
                            Command="{Binding SetCenterCommand}"
                            Width="80" Height="36"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                            CornerRadius="6"
                            HorizontalContentAlignment="Center"
                            Classes.selected="{Binding IsCenter}"/>
                    <Button Content="Right"
                            Command="{Binding SetRightCommand}"
                            Width="80" Height="36"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                            CornerRadius="6"
                            HorizontalContentAlignment="Center"
                            Classes.selected="{Binding IsRight}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Validation message -->
        <Border Grid.Row="3"
                Background="#C0392B"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0"
                IsVisible="{Binding HasValidationError}">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
