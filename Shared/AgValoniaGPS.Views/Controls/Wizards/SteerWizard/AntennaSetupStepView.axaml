<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:steer="clr-namespace:AgValoniaGPS.ViewModels.Wizards.SteerWizard;assembly=AgValoniaGPS.ViewModels"
             xmlns:conv="using:AgValoniaGPS.Views.Converters"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="600"
             x:Class="AgValoniaGPS.Views.Controls.Wizards.SteerWizard.AntennaSetupStepView"
             x:DataType="steer:AntennaSetupStepViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                   Margin="0,0,0,12"/>

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Description}"
                   FontSize="14"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                   TextWrapping="Wrap"
                   LineHeight="22"
                   Margin="0,0,0,24"/>

        <!-- Content: large antenna diagram with overlaid fields -->
        <Grid Grid.Row="2">
            <!-- Antenna diagram fills the step area -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="12"
                    Padding="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <Image Source="{Binding AntennaIconSource, Converter={x:Static conv:StringToImageConverter.Instance}}"
                       Stretch="Uniform"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
            </Border>

            <!-- Overlaid input fields at bottom -->
            <ScrollViewer VerticalAlignment="Bottom" VerticalScrollBarVisibility="Auto" MaxHeight="340">
                <StackPanel Spacing="6" Margin="12,0,12,12">
                    <!-- Pivot Distance -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="10" Padding="14,8" Opacity="0.95">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Pivot Distance" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="Antenna to rear axle (+ = ahead)" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding AntennaPivot, StringFormat='{}{0:F2}'}"
                                         FontSize="16" FontWeight="Bold" Width="90" TextAlignment="Center"
                                         Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                         BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                         BorderThickness="2" CornerRadius="8" Padding="6,4"/>
                                <TextBlock Text="m" FontSize="14"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Height -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="10" Padding="14,8" Opacity="0.95">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Height" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="Antenna above ground" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding AntennaHeight, StringFormat='{}{0:F2}'}"
                                         FontSize="16" FontWeight="Bold" Width="90" TextAlignment="Center"
                                         Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                         BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                         BorderThickness="2" CornerRadius="8" Padding="6,4"/>
                                <TextBlock Text="m" FontSize="14"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Offset direction icon buttons (L/C/R) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,4">
                        <Button Command="{Binding SetLeftCommand}"
                                Width="100" Height="80"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="8"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand"
                                Classes.selected="{Binding IsLeft}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/AntennaLeftOffset.png"
                                       Width="48" Height="48" Stretch="Uniform"
                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Left" FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SetCenterCommand}"
                                Width="100" Height="80"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="8"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand"
                                Classes.selected="{Binding IsCenter}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/AntennaNoOffset.png"
                                       Width="48" Height="48" Stretch="Uniform"
                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Center" FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SetRightCommand}"
                                Width="100" Height="80"
                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                CornerRadius="8"
                                HorizontalContentAlignment="Center"
                                Cursor="Hand"
                                Classes.selected="{Binding IsRight}">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/AntennaRightOffset.png"
                                       Width="48" Height="48" Stretch="Uniform"
                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Right" FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Lateral Offset value input -->
                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            CornerRadius="10" Padding="14,8" Opacity="0.95"
                            HorizontalAlignment="Center" MinWidth="300">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Lateral Offset" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock Text="From centerline (+ = right)" FontSize="11"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBox Text="{Binding AntennaOffset, StringFormat='{}{0:F2}'}"
                                         FontSize="16" FontWeight="Bold" Width="90" TextAlignment="Center"
                                         Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                         Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                         BorderBrush="{DynamicResource SystemControlHighlightAccentBrush}"
                                         BorderThickness="2" CornerRadius="8" Padding="6,4"/>
                                <TextBlock Text="m" FontSize="14"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Validation message -->
        <Border Grid.Row="3"
                Background="#C0392B"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0"
                IsVisible="{Binding HasValidationError}">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
