<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:steer="clr-namespace:AgValoniaGPS.ViewModels.Wizards.SteerWizard;assembly=AgValoniaGPS.ViewModels"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="550"
             x:Class="AgValoniaGPS.Views.Controls.Wizards.SteerWizard.MotorDirectionTestStepView"
             x:DataType="steer:MotorDirectionTestStepViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                   Margin="0,0,0,12"/>

        <!-- Description -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Description}"
                   FontSize="14"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                   TextWrapping="Wrap"
                   LineHeight="22"
                   Margin="0,0,0,24"/>

        <!-- Content -->
        <StackPanel Grid.Row="2" Spacing="16">
            <!-- Live WAS angle display -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="12"
                    Padding="20"
                    HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="Live Steer Angle"
                               FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding LiveSteerAngle, StringFormat='{}{0:F1}'}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Pulse buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16"
                        IsVisible="{Binding HasHardware}">
                <Button Command="{Binding PulseLeftCommand}"
                        Width="80" Height="72"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="8" HorizontalContentAlignment="Center"
                        Cursor="Hand" ToolTip.Tip="Pulse Left"
                        IsEnabled="{Binding !IsPulsing}">
                    <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/SteerLeft.png"
                           Width="48" Height="48" Stretch="Uniform"/>
                </Button>
                <Button Command="{Binding PulseRightCommand}"
                        Width="80" Height="72"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="8" HorizontalContentAlignment="Center"
                        Cursor="Hand" ToolTip.Tip="Pulse Right"
                        IsEnabled="{Binding !IsPulsing}">
                    <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/SteerRight.png"
                           Width="48" Height="48" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- Pulse status text -->
            <TextBlock Text="{Binding PulseStatus}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsPulsing}"/>

            <!-- No hardware message -->
            <TextBlock Text="No hardware connected"
                       FontSize="12"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding !HasHardware}"/>

            <!-- Invert Motor toggle -->
            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    CornerRadius="8" Padding="16,12" HorizontalAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Image Grid.Column="0"
                           Source="avares://AgValoniaGPS.Views/Assets/Icons/ConSt_InvertDirection.png"
                           Width="32" Height="32" Stretch="Uniform"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Invert Motor" FontSize="16"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        <TextBlock Text="Enable if motor drives in wrong direction" FontSize="12"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding InvertMotor}"
                                  OnContent="ON" OffContent="OFF"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Validation message -->
        <Border Grid.Row="3"
                Background="#C0392B"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0"
                IsVisible="{Binding HasValidationError}">
            <TextBlock Text="{Binding ValidationMessage}"
                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                       FontSize="14"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
