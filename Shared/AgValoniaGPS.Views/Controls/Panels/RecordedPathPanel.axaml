<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgValoniaGPS.ViewModels"
             mc:Ignorable="d"
             x:Class="AgValoniaGPS.Views.Controls.Panels.RecordedPathPanel"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsRecordedPathPanelVisible}"
             IsHitTestVisible="{Binding IsRecordedPathPanelVisible}">

    <UserControl.Styles>
        <Style Selector="Border.FloatingPanel">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.RecPathBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>
        <Style Selector="Button.RecPathBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="FloatingPanel" MinWidth="320">
        <StackPanel Spacing="4">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" Height="28" Margin="0,0,0,4"
                  Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Cursor="Hand">
                <TextBlock Grid.Column="0" Text="=" Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,8,0" IsHitTestVisible="False"/>
                <TextBlock Grid.Column="1" Text="Recorded Path"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Grid.Column="2" Content="X" Width="22" Height="22" Padding="0" BorderThickness="0"
                        Background="Transparent" Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        FontSize="14" Cursor="Hand" Command="{Binding ToggleRecordedPathPanelCommand}" Margin="4,0,4,0"/>
            </Grid>

            <!-- Control Buttons Row 1: Play/Stop, Resume Mode, Record/Stop -->
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <Button Classes="RecPathBtn" Command="{Binding PlayRecordedPathCommand}" ClickMode="Press"
                        ToolTip.Tip="Start/Stop playback">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding State.RecordedPath.IsDrivingRecordedPath,
                            FallbackValue='Play',
                            StringFormat='{}{0}'}"
                            FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="RecPathBtn" Command="{Binding CycleResumeModeCommand}" ClickMode="Press"
                        ToolTip.Tip="Resume mode: Start / Last / Closest">
                    <TextBlock Text="{Binding ResumeModeLabel}" FontSize="11"/>
                </Button>

                <Button Classes="RecPathBtn" Command="{Binding StartRecordedPathCommand}" ClickMode="Press"
                        ToolTip.Tip="Start recording"
                        IsVisible="{Binding !IsRecordingPath}">
                    <TextBlock Text="Rec" FontSize="11" Foreground="#E74C3C"/>
                </Button>
                <Button Classes="RecPathBtn" Command="{Binding StopRecordedPathCommand}" ClickMode="Press"
                        ToolTip.Tip="Stop recording" Background="#C0392B"
                        IsVisible="{Binding IsRecordingPath}">
                    <TextBlock Text="Stop Rec" FontSize="11" Foreground="White"/>
                </Button>
            </StackPanel>

            <!-- Control Buttons Row 2: Reverse, Pick, Turn Off -->
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <Button Classes="RecPathBtn" Command="{Binding ReverseRecordedPathCommand}" ClickMode="Press"
                        ToolTip.Tip="Reverse path direction">
                    <TextBlock Text="Reverse" FontSize="11"/>
                </Button>

                <Button Classes="RecPathBtn" Command="{Binding ToggleRecordedPathsCommand}" ClickMode="Press"
                        ToolTip.Tip="Toggle path visibility">
                    <TextBlock Text="Show/Hide" FontSize="11"/>
                </Button>

                <Button Classes="RecPathBtn" Command="{Binding TurnOffRecordedPathCommand}" ClickMode="Press"
                        ToolTip.Tip="Clear and close recorded path">
                    <TextBlock Text="Turn Off" FontSize="11" Foreground="#E74C3C"/>
                </Button>
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Margin="4,2"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                       TextWrapping="Wrap" MaxWidth="300"/>
        </StackPanel>
    </Border>
</UserControl>
