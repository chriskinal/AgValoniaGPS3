<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgValoniaGPS.ViewModels"
             xmlns:controls="using:AgValoniaGPS.Views.Controls.Panels"
             xmlns:c="using:AgValoniaGPS.Views.Controls"
             xmlns:loc="clr-namespace:AgValoniaGPS.Views.Localization;assembly=AgValoniaGPS.Views"
             mc:Ignorable="d"
             x:Class="AgValoniaGPS.Views.Controls.Panels.LeftNavigationPanel"
             x:DataType="vm:MainViewModel"
             ClipToBounds="False"
             Background="{x:Null}"
             IsHitTestVisible="True">

    <UserControl.Styles>
        <!-- Floating Panel Style -->
        <Style Selector="Border.FloatingPanel">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Left Panel Button Style -->
        <Style Selector="Button.LeftPanelButton">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.LeftPanelButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>
        <Style Selector="Button.LeftPanelButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumBrush}"/>
        </Style>

        <!-- Left Panel Separator -->
        <Style Selector="Separator.LeftPanelSeparator">
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Margin" Value="8,4"/>
        </Style>
    </UserControl.Styles>

    <!-- Panel for proper layout measurement; Canvas overlay for sub-panels -->
    <!-- Background must be null (not set) to allow pointer events to pass through to controls behind -->
    <Panel ClipToBounds="False" Background="{x:Null}">
        <!-- Navigation Button Bar -->
        <Border Classes="FloatingPanel">
            <StackPanel x:Name="ButtonStack" Spacing="6" Orientation="Vertical">
                <!-- 1. Application Settings (language, hotkeys, NTRIP profiles, simulator, etc.) -->
                <c:GlyphButton Glyph="{StaticResource Glyph.Settings}"
                               IsGlyphFilled="True"
                               Label="{loc:Localize Btn.Settings}"
                               ToolTip.Tip="Application Settings"
                               Command="{Binding ToggleFileMenuPanelCommand}"/>

                <Separator Classes="LeftPanelSeparator"/>

                <!-- 2. View Settings -->
                <c:GlyphButton Glyph="{StaticResource Glyph.View}"
                               Label="{loc:Localize Btn.View}"
                               ToolTip.Tip="View Settings"
                               Command="{Binding ToggleViewSettingsPanelCommand}"/>

                <!-- 3. Tools -->
                <c:GlyphButton Glyph="{StaticResource Glyph.Tools}"
                               IsGlyphFilled="True"
                               Label="{loc:Localize Btn.Tools}"
                               ToolTip.Tip="Tools"
                               Command="{Binding ToggleToolsPanelCommand}"/>

                <!-- 4. Vehicle Configuration -->
                <c:GlyphButton Glyph="{StaticResource Glyph.Vehicle}"
                               IsGlyphFilled="True"
                               Label="{loc:Localize Btn.Vehicle}"
                               ToolTip.Tip="Vehicle Configuration"
                               Command="{Binding ToggleConfigurationPanelCommand}"/>

                <!-- 5. Field Operations -->
                <c:GlyphButton Glyph="{StaticResource Glyph.Fields}"
                               IsGlyphFilled="True"
                               Label="{loc:Localize Btn.Fields}"
                               ToolTip.Tip="Field Operations"
                               Command="{Binding ToggleFieldOperationsPanelCommand}"/>

                <!-- 6. Field Tools (includes Boundary) -->
                <c:GlyphButton Glyph="{StaticResource Glyph.FieldTools}"
                               IsGlyphFilled="True"
                               Label="{loc:Localize Btn.FieldTools}"
                               ToolTip.Tip="Field Tools"
                               Command="{Binding ToggleFieldToolsPanelCommand}"/>

                <!-- 7. AutoSteer Config (left = setup; the runtime engage lives on the right panel) -->
                <c:GlyphButton Glyph="{StaticResource Glyph.SteerConfig}"
                               IsGlyphFilled="True"
                               Label="{loc:Localize Btn.SteerConfig}"
                               ToolTip.Tip="AutoSteer Configuration"
                               Command="{Binding ShowAutoSteerConfigCommand}"/>
            </StackPanel>
        </Border>

        <!-- Sub-panels Canvas overlay (absolute positioning relative to nav bar) -->
        <Canvas ClipToBounds="False">
        <!-- View Settings Panel -->
        <controls:ViewSettingsPanel x:Name="ViewSettingsPanelControl"
                                    Canvas.Left="90" Canvas.Top="0"
                                    ZIndex="15"
                                    DataContext="{Binding}"/>

        <!-- File Menu Panel -->
        <controls:FileMenuPanel x:Name="FileMenuPanelControl"
                                Canvas.Left="90" Canvas.Top="0"
                                ZIndex="15"
                                DataContext="{Binding}"/>

        <!-- Tools Panel -->
        <controls:ToolsPanel x:Name="ToolsPanelControl"
                             Canvas.Left="90" Canvas.Top="0"
                             ZIndex="15"
                             DataContext="{Binding}"/>

        <!-- Configuration Panel -->
        <controls:ConfigurationPanel x:Name="ConfigurationPanelControl"
                                     Canvas.Left="90" Canvas.Top="0"
                                     ZIndex="15"
                                     DataContext="{Binding}"/>

        <!-- Field Operations Panel -->
        <controls:FieldOperationsPanel x:Name="FieldOperationsPanelControl"
                                       Canvas.Left="90" Canvas.Top="0"
                                       ZIndex="15"
                                       DataContext="{Binding}"/>

        <!-- Field Tools Panel -->
        <controls:FieldToolsPanel x:Name="FieldToolsPanelControl"
                                  Canvas.Left="90" Canvas.Top="0"
                                  ZIndex="15"
                                  DataContext="{Binding}"/>

        <!-- Simulator Panel -->
        <controls:SimulatorPanel x:Name="SimulatorPanelControl"
                                 Canvas.Left="90" Canvas.Top="150"
                                 ZIndex="15"
                                 DataContext="{Binding}"/>

        <!-- Boundary Recording Panel -->
        <controls:BoundaryRecordingPanel x:Name="BoundaryRecordingPanelControl"
                                          Canvas.Left="200" Canvas.Top="50"
                                          ZIndex="20"
                                          DataContext="{Binding}"/>

        <!-- Boundary Player Panel -->
        <controls:BoundaryPlayerPanel x:Name="BoundaryPlayerPanelControl"
                                       Canvas.Left="100" Canvas.Top="0"
                                       ZIndex="25"
                                       DataContext="{Binding}"/>
        </Canvas>
    </Panel>
</UserControl>
