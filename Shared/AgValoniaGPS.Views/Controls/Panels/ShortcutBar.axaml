<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgValoniaGPS.ViewModels"
             xmlns:converters="using:AgValoniaGPS.Views.Converters"
             mc:Ignorable="d"
             x:Class="AgValoniaGPS.Views.Controls.Panels.ShortcutBar"
             x:DataType="vm:MainViewModel"
             ClipToBounds="False"
             Background="{x:Null}"
             IsHitTestVisible="True">

    <UserControl.Resources>
        <converters:AvaresImageConverter x:Key="AvaresImageConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Floating Panel Style -->
        <Style Selector="Border.FloatingPanel">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Shortcut Button Style -->
        <Style Selector="Button.ShortcutButton">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ShortcutButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>
        <Style Selector="Button.ShortcutButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumBrush}"/>
        </Style>

        <!-- Active State for toggle buttons -->
        <Style Selector="Button.ShortcutButton.Active">
            <Setter Property="Background" Value="#DD2ECC71"/>
        </Style>
        <Style Selector="Button.ShortcutButton.Active:pointerover">
            <Setter Property="Background" Value="#DD27AE60"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="FloatingPanel">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <ItemsControl ItemsSource="{Binding ActiveShortcutButtons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShortcutButtonViewModel">
                        <Panel>
                            <!-- Standard icon button (no overlay text) -->
                            <Button Classes="ShortcutButton"
                                    Classes.Active="{Binding IsActive}"
                                    Command="{Binding Command}"
                                    ToolTip.Tip="{Binding Tooltip}"
                                    IsVisible="{Binding HasOverlayText, Converter={StaticResource InverseBoolConverter}}">
                                <Image Source="{Binding CurrentIconResource, Converter={StaticResource AvaresImageConverter}}" Stretch="Uniform"/>
                            </Button>
                            <!-- Section-style button with overlay text and dynamic background -->
                            <Button Classes="ShortcutButton"
                                    Command="{Binding Command}"
                                    ToolTip.Tip="{Binding Tooltip}"
                                    IsVisible="{Binding HasOverlayText}"
                                    Background="{Binding BackgroundColorHex}">
                                <TextBlock Text="{Binding OverlayText}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Gear icon to open shortcut editor -->
            <Button Classes="ShortcutButton"
                    ToolTip.Tip="Customize Shortcuts"
                    Command="{Binding ShowShortcutEditorCommand}">
                <TextBlock Text="&#x2699;" FontSize="28"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
