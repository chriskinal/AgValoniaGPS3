<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgValoniaGPS.ViewModels"
             mc:Ignorable="d"
             x:Class="AgValoniaGPS.Views.Controls.Panels.ShortcutBar"
             x:DataType="vm:MainViewModel"
             ClipToBounds="False"
             Background="{x:Null}"
             IsHitTestVisible="True">

    <UserControl.Styles>
        <!-- Floating Panel Style -->
        <Style Selector="Border.FloatingPanel">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Shortcut Button Style -->
        <Style Selector="Button.ShortcutButton">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.ShortcutButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>
        <Style Selector="Button.ShortcutButton:pressed">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumBrush}"/>
        </Style>

        <!-- Active State for toggle buttons -->
        <Style Selector="Button.ShortcutButton.Active">
            <Setter Property="Background" Value="#DD2ECC71"/>
        </Style>
        <Style Selector="Button.ShortcutButton.Active:pointerover">
            <Setter Property="Background" Value="#DD27AE60"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="FloatingPanel">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <ItemsControl ItemsSource="{Binding ActiveShortcutButtons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ShortcutButtonViewModel">
                        <Button Classes="ShortcutButton"
                                Classes.Active="{Binding IsActive}"
                                Command="{Binding Command}"
                                ToolTip.Tip="{Binding Tooltip}"
                                IsVisible="{Binding IsVisible}">
                            <Image Source="{Binding CurrentIcon}" Stretch="Uniform"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Gear icon to open shortcut editor -->
            <Button Classes="ShortcutButton" Width="36" Height="36"
                    ToolTip.Tip="Customize Shortcuts"
                    Command="{Binding ShowShortcutEditorCommand}"
                    Padding="6" Opacity="0.6">
                <TextBlock Text="&#x2699;" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
