<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgValoniaGPS.ViewModels"
             xmlns:converters="clr-namespace:AgValoniaGPS.Views.Converters;assembly=AgValoniaGPS.Views"
             mc:Ignorable="d"
             x:Class="AgValoniaGPS.Views.Controls.Dialogs.FieldBuilderDialogPanel"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding State.UI.IsFieldBuilderDialogVisible}"
             IsHitTestVisible="{Binding State.UI.IsFieldBuilderDialogVisible}">

    <UserControl.Styles>
        <Style Selector="Button.FBBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style Selector="Button.FBBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover">
            <Setter Property="Background" Value="#2ECC71"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Backdrop -->
        <Border Background="#80000000" PointerPressed="Backdrop_PointerPressed"/>

        <!-- Dialog -->
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="12" Padding="16" MinWidth="800" MaxWidth="1000"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 8 32 #40000000">
            <Grid RowDefinitions="Auto,*">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Field Builder" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <Button Grid.Column="1" Content="X" Width="28" Height="28" Padding="0"
                            Background="Transparent" Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            FontSize="16" Cursor="Hand" Command="{Binding CloseFieldBuilderCommand}"/>
                </Grid>

                <!-- Main: Visualizer + Right Panel -->
                <Grid Grid.Row="1" ColumnDefinitions="*,280" ColumnSpacing="12" MinHeight="400">

                    <!-- LEFT: Boundary/Track Visualizer -->
                    <Border Grid.Column="0" Background="#1A1A2E" CornerRadius="8" ClipToBounds="True">
                        <Canvas x:Name="BoundaryPreview"/>
                    </Border>

                    <!-- RIGHT: Tabs for main content, track creation sub-panel -->
                    <TabControl Grid.Column="1" TabStripPlacement="Top" x:Name="MainTabs">

                        <!-- === TAB 1: TRACKS (list + add button) === -->
                        <TabItem Header="Tracks">
                            <StackPanel Spacing="6" Margin="0,6">
                                <!-- Action buttons ABOVE track list -->
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Width="48" Height="48" CornerRadius="8" Cursor="Hand" Padding="0"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            ToolTip.Tip="Add Track" BorderThickness="0"
                                            x:Name="AddTrackBtn" Click="AddTrackBtn_Click">
                                        <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackAPlus.png"
                                               Width="32" Height="32" Stretch="Uniform"/>
                                    </Button>
                                    <Button Width="48" Height="48" CornerRadius="8" Cursor="Hand" Padding="0"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            ToolTip.Tip="Edit Selected Track" BorderThickness="0"
                                            Command="{Binding ShowDrawABDialogCommand}">
                                        <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABDraw.png"
                                               Width="32" Height="32" Stretch="Uniform"/>
                                    </Button>
                                    <Button Width="48" Height="48" CornerRadius="8" Cursor="Hand" Padding="0"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            ToolTip.Tip="Delete Selected Track" BorderThickness="0"
                                            Command="{Binding DeleteSelectedTrackCommand}">
                                        <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/TrashContourRef.png"
                                               Width="32" Height="32" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>

                                <!-- Track list -->
                                <ListBox ItemsSource="{Binding SavedTracks}"
                                         SelectedItem="{Binding SelectedTrack}"
                                         MaxHeight="220" CornerRadius="4"
                                         Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding IsActive, Converter={x:Static converters:BoolToToggleBackgroundConverter.Instance}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No tracks" FontSize="10"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                                           IsVisible="{Binding !SavedTracks.Count}"/>
                            </StackPanel>
                        </TabItem>

                        <!-- === TAB 2: HEADLAND === -->
                        <TabItem Header="Headland">
                            <StackPanel Spacing="10" Margin="0,6">
                                <TextBlock Text="Working boundary inside the field edge."
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                                           FontSize="11" TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Distance:" FontSize="14"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="-" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Command="{Binding DecreaseHeadlandDistanceCommand}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        <TextBlock Text="{Binding HeadlandDistance, StringFormat='{}{0:F1}m'}"
                                                   FontSize="18" FontWeight="Bold" Width="60" TextAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="+" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Command="{Binding IncreaseHeadlandDistanceCommand}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding HeadlandStatusText}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" FontSize="11"/>

                                <Button Classes="ActionBtn" Content="Build Headland"
                                        Command="{Binding BuildHeadlandCommand}"/>
                            </StackPanel>
                        </TabItem>

                        <!-- === TAB 3: TRAM LINES === -->
                        <TabItem Header="Tram Lines">
                            <StackPanel Spacing="8" Margin="0,6">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="Track:" FontSize="11"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" FontWeight="Bold"
                                               Text="{Binding SelectedTrack.Name, FallbackValue='None'}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBlock Grid.Row="1" Text="Lines:" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"
                                               Text="{Binding TramLineCountDisplay}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Passes:" FontSize="14"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="-" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Command="{Binding DecreaseTramPassesCommand}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        <TextBlock Text="{Binding TramPasses}" FontSize="18" FontWeight="Bold"
                                                   Width="36" TextAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="+" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Command="{Binding IncreaseTramPassesCommand}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
                                    <Button Grid.Column="0" Content="Off" Command="{Binding SetTramModeOffCommand}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Stretch" Height="32" FontSize="11"/>
                                    <Button Grid.Column="1" Content="All" Command="{Binding SetTramModeAllCommand}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Stretch" Height="32" FontSize="11"/>
                                    <Button Grid.Column="2" Content="Lines" Command="{Binding SetTramModeLinesCommand}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Stretch" Height="32" FontSize="11"/>
                                    <Button Grid.Column="3" Content="Outer" Command="{Binding SetTramModeOuterCommand}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Stretch" Height="32" FontSize="11"/>
                                </Grid>

                                <Button Classes="ActionBtn" Content="Build Tram Lines"
                                        Command="{Binding BuildTramLinesCommand}"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- ADD TRACK SUB-PANEL (replaces tabs when visible) -->
                    <Border Grid.Column="1" x:Name="AddTrackPanel" IsVisible="False"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <StackPanel Spacing="6" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Grid.Column="0" Padding="8,4" FontSize="12" CornerRadius="4" Cursor="Hand"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                        x:Name="BackBtn" Click="BackBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="&lt;" FontWeight="Bold"/>
                                        <TextBlock Text="Back"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="1" Text="Add Track" FontWeight="Bold" FontSize="15"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <TabControl TabStripPlacement="Top">
                                <!-- Free Draw tab -->
                                <TabItem Header="Free Draw">
                                    <StackPanel Spacing="8" Margin="0,8">
                                        <Button Classes="FBBtn" Command="{Binding StartDrawABModeCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABLineCycle.png"
                                                       Width="20" Height="20" Stretch="Uniform"/>
                                                <TextBlock Text="AB Line" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="FBBtn" Command="{Binding StartDrawCurveModeCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackCurve.png"
                                                       Width="20" Height="20" Stretch="Uniform"/>
                                                <TextBlock Text="Curve" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="FBBtn" Command="{Binding CreateALineFromPositionCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackAPlus.png"
                                                       Width="20" Height="20" Stretch="Uniform"/>
                                                <TextBlock Text="A+ Line (point + heading)" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </TabItem>

                                <!-- From Boundary tab -->
                                <TabItem Header="From Boundary">
                                    <StackPanel Spacing="8" Margin="0,8">
                                        <Button Classes="FBBtn" Command="{Binding CreateTrackFromBoundaryCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABLineCycle.png"
                                                       Width="20" Height="20" Stretch="Uniform"/>
                                                <TextBlock Text="AB from Longest Edge" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="FBBtn" Command="{Binding CreateCurveFromBoundaryCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackCurve.png"
                                                       Width="20" Height="20" Stretch="Uniform"/>
                                                <TextBlock Text="Boundary Curve" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="FBBtn" Command="{Binding CreateTracksFromAllEdgesCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTracks.png"
                                                       Width="20" Height="20" Stretch="Uniform"/>
                                                <TextBlock Text="AB from All Edges" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
