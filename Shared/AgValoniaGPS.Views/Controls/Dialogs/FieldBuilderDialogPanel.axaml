<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AgValoniaGPS.ViewModels"
             xmlns:converters="clr-namespace:AgValoniaGPS.Views.Converters;assembly=AgValoniaGPS.Views"
             mc:Ignorable="d"
             x:Class="AgValoniaGPS.Views.Controls.Dialogs.FieldBuilderDialogPanel"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding State.UI.IsFieldBuilderDialogVisible}"
             IsHitTestVisible="{Binding State.UI.IsFieldBuilderDialogVisible}">

    <UserControl.Styles>
        <Style Selector="Button.FBBtn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="36"/>
        </Style>
        <Style Selector="Button.FBBtn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"/>
        </Style>
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.ActionBtn:pointerover">
            <Setter Property="Background" Value="#2ECC71"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Backdrop -->
        <Border Background="#80000000" PointerPressed="Backdrop_PointerPressed"/>

        <!-- Dialog - full screen -->
        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="0" Padding="16"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Panel>
            <Grid RowDefinitions="Auto,*">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="Field Builder" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <Button Grid.Column="1" Width="44" Height="44" Padding="0"
                            Background="#C0392B" Foreground="White" CornerRadius="8"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Cursor="Hand" Command="{Binding CloseFieldBuilderCommand}">
                        <TextBlock Text="X" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Main: Visualizer + Right Panel -->
                <Grid Grid.Row="1" ColumnDefinitions="*,340" ColumnSpacing="12">

                    <!-- LEFT: Boundary/Track Visualizer -->
                    <Border Grid.Column="0" Background="#1A1A2E" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Canvas x:Name="BoundaryPreview" PointerPressed="Canvas_PointerPressed" Background="Transparent"/>
                            <TextBlock x:Name="NoFieldText" Text="No field open"
                                       FontSize="24" Foreground="#60FFFFFF" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsFieldOpen}"/>
                        </Grid>
                    </Border>

                    <!-- RIGHT: Tabs for main content, track creation sub-panel -->
                    <TabControl Grid.Column="1" TabStripPlacement="Top" x:Name="MainTabs">

                        <!-- === TAB 1: TRACKS (list + add button) === -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="12,4">
                                    <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/TrackOn.png"
                                           Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tracks" FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <StackPanel Spacing="6" Margin="0,6">
                                <!-- Header with overflow menu -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Track List" FontWeight="Bold" FontSize="16"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}">
                                        <Button.Flyout>
                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                <MenuItem Header="Delete All Tracks"
                                                          Click="DeleteAllTracks_Click"/>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <TextBlock Text="..." FontSize="20" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>

                                <!-- Track list -->
                                <ListBox ItemsSource="{Binding SavedTracks}"
                                         SelectedItem="{Binding SelectedTrack}"
                                         MaxHeight="220" CornerRadius="4"
                                         Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Ellipse Width="8" Height="8"
                                                         Fill="{Binding IsActive, Converter={x:Static converters:BoolToToggleBackgroundConverter.Instance}}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="14"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No tracks" FontSize="16"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                                           IsVisible="{Binding !SavedTracks.Count}"/>

                                <!-- Action buttons below list -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <StackPanel Spacing="2">
                                        <Button Width="56" Height="56" CornerRadius="8" Cursor="Hand" Padding="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0"
                                                ToolTip.Tip="Add Track" x:Name="AddTrackBtn" Click="AddTrackBtn_Click">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/AddNew.png"
                                                   Width="36" Height="36" Stretch="Uniform"/>
                                        </Button>
                                        <TextBlock Text="Add" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <Button Width="56" Height="56" CornerRadius="8" Cursor="Hand" Padding="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0"
                                                ToolTip.Tip="Edit Track" Command="{Binding ShowDrawABDialogCommand}">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABDraw.png"
                                                   Width="36" Height="36" Stretch="Uniform"/>
                                        </Button>
                                        <TextBlock Text="Edit" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <Button Width="56" Height="56" CornerRadius="8" Cursor="Hand" Padding="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" BorderThickness="0"
                                                ToolTip.Tip="Delete Track" Command="{Binding DeleteSelectedTrackCommand}">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/Trash.png"
                                                   Width="36" Height="36" Stretch="Uniform"/>
                                        </Button>
                                        <TextBlock Text="Delete" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </TabItem>

                        <!-- === TAB 2: HEADLAND === -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="12,4">
                                    <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/HeadlandOn.png"
                                           Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Headland" FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="0,6">
                                <!-- Track Type Selection -->
                                <TextBlock Text="Track Type" FontSize="12"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                <Grid ColumnDefinitions="*,*" Height="56">
                                    <RadioButton Grid.Column="0" GroupName="HeadlandTrackType" HorizontalAlignment="Stretch"
                                                 IsChecked="{Binding IsHeadlandCurveMode}" Margin="0,0,3,0">
                                        <RadioButton.Template>
                                            <ControlTemplate>
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6" Cursor="Hand">
                                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                        <RadioButton.Styles>
                                            <Style Selector="RadioButton">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                                            </Style>
                                            <Style Selector="RadioButton:checked">
                                                <Setter Property="Background" Value="#1ABC9C"/>
                                            </Style>
                                        </RadioButton.Styles>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackCurve.png" Width="28" Height="28"/>
                                            <TextBlock Text="Curve" FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Grid.Column="1" GroupName="HeadlandTrackType" HorizontalAlignment="Stretch"
                                                 IsChecked="{Binding IsHeadlandLineMode}" Margin="3,0,0,0">
                                        <RadioButton.Template>
                                            <ControlTemplate>
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="6" Cursor="Hand">
                                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                        <RadioButton.Styles>
                                            <Style Selector="RadioButton">
                                                <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
                                            </Style>
                                            <Style Selector="RadioButton:checked">
                                                <Setter Property="Background" Value="#1ABC9C"/>
                                            </Style>
                                        </RadioButton.Styles>
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackAB.png" Width="28" Height="28"/>
                                            <TextBlock Text="Line" FontSize="11" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <!-- Distance -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Distance:" FontSize="14"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Content="-" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Command="{Binding IncrementHeadlandDistanceCommand}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        <TextBlock Text="{Binding HeadlandDistance, StringFormat='{}{0:F1}m'}"
                                                   FontSize="18" FontWeight="Bold" Width="60" TextAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="+" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Command="{Binding DecrementHeadlandDistanceCommand}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Tool Width Multiplier -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Tool Widths:" FontSize="14"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding HeadlandCalculatedWidth, StringFormat='{}{0:F2}m'}"
                                                   FontSize="14" Foreground="#1ABC9C" VerticalAlignment="Center" Width="60" TextAlignment="Center"/>
                                        <ComboBox Width="56" FontSize="14"
                                                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                  Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                  SelectedIndex="{Binding HeadlandToolWidthMultiplier}">
                                            <ComboBoxItem>0</ComboBoxItem>
                                            <ComboBoxItem>1</ComboBoxItem>
                                            <ComboBoxItem>2</ComboBoxItem>
                                            <ComboBoxItem>3</ComboBoxItem>
                                            <ComboBoxItem>4</ComboBoxItem>
                                            <ComboBoxItem>5</ComboBoxItem>
                                            <ComboBoxItem>6</ComboBoxItem>
                                            <ComboBoxItem>7</ComboBoxItem>
                                            <ComboBoxItem>8</ComboBoxItem>
                                            <ComboBoxItem>9</ComboBoxItem>
                                            <ComboBoxItem>10</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding HeadlandStatusText}"
                                           Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" FontSize="13"/>

                                <!-- Build / Reset -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                    <Button Grid.Column="0" Classes="ActionBtn" Command="{Binding BuildHeadlandCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/HeadlandBuild.png" Width="20" Height="20"/>
                                            <TextBlock Text="Build" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="FBBtn" Command="{Binding ResetHeadlandCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/HeadlandReset.png" Width="20" Height="20"/>
                                            <TextBlock Text="Reset" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Clip / Undo -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                    <Button Grid.Column="0" Classes="FBBtn" Command="{Binding ClipHeadlandLineCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/HeadlandSlice.png" Width="20" Height="20"/>
                                            <TextBlock Text="Clip" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="FBBtn" Command="{Binding UndoHeadlandCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/UndoButton.png" Width="20" Height="20"/>
                                            <TextBlock Text="Undo" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Section Control Toggle -->
                                <ToggleButton HorizontalAlignment="Stretch" Height="40"
                                              IsChecked="{Binding IsHeadlandSectionControlled}"
                                              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                              CornerRadius="6" Cursor="Hand" BorderThickness="0">
                                    <ToggleButton.Styles>
                                        <Style Selector="ToggleButton:checked">
                                            <Setter Property="Background" Value="#1ABC9C"/>
                                        </Style>
                                    </ToggleButton.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Panel Width="24" Height="24">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/HeadlandSectionOn.png"
                                                   Width="24" Height="24" IsVisible="{Binding IsHeadlandSectionControlled}"/>
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/HeadlandSectionOff.png"
                                                   Width="24" Height="24" IsVisible="{Binding !IsHeadlandSectionControlled}"/>
                                        </Panel>
                                        <TextBlock Text="Section Control" VerticalAlignment="Center" FontSize="14"/>
                                    </StackPanel>
                                </ToggleButton>

                                <!-- Turn Off -->
                                <Button HorizontalAlignment="Stretch" Height="36"
                                        Background="#C0392B" Foreground="White" CornerRadius="6"
                                        BorderThickness="0" Cursor="Hand"
                                        Command="{Binding TurnOffHeadlandCommand}">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#E74C3C"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/SwitchOff.png" Width="20" Height="20"/>
                                        <TextBlock Text="Turn Off" VerticalAlignment="Center" FontSize="14"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- === TAB 3: TRAM LINES === -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="12,4">
                                    <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/TramAll.png"
                                           Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Tram" FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                            <StackPanel Spacing="8" Margin="0,6">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="Track:" FontSize="14"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="14" FontWeight="Bold"
                                               Text="{Binding SelectedTrack.Name, FallbackValue='None'}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBlock Grid.Row="1" Text="Lines:" FontSize="14" Margin="0,2,0,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="0,2,0,0"
                                               Text="{Binding TramLineCountDisplay}"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Passes:" FontSize="14"
                                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Content="-" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Command="{Binding DecreaseTramPassesCommand}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        <TextBlock Text="{Binding TramPasses}" FontSize="18" FontWeight="Bold"
                                                   Width="36" TextAlignment="Center"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="+" Width="36" Height="36" FontSize="18" FontWeight="Bold"
                                                Command="{Binding IncreaseTramPassesCommand}"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
                                    <Button Grid.Column="0" Content="Off" Command="{Binding SetTramModeOffCommand}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Stretch" Height="32" FontSize="14"/>
                                    <Button Grid.Column="1" Content="All" Command="{Binding SetTramModeAllCommand}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Stretch" Height="32" FontSize="14"/>
                                    <Button Grid.Column="2" Content="Lines" Command="{Binding SetTramModeLinesCommand}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Stretch" Height="32" FontSize="14"/>
                                    <Button Grid.Column="3" Content="Outer" Command="{Binding SetTramModeOuterCommand}"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                            HorizontalAlignment="Stretch" Height="32" FontSize="14"/>
                                </Grid>

                                <Button Classes="ActionBtn" Content="Build Tram Lines"
                                        Command="{Binding BuildTramLinesCommand}"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- ADD TRACK SUB-PANEL (replaces tabs when visible) -->
                    <Border Grid.Column="1" x:Name="AddTrackPanel" IsVisible="False"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                        <StackPanel Spacing="6" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*">
                                <Button Grid.Column="0" Padding="8,4" FontSize="14" CornerRadius="4" Cursor="Hand"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                        x:Name="BackBtn" Click="BackBtn_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="&lt;" FontWeight="Bold"/>
                                        <TextBlock Text="Back"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="1" Text="Add Track" FontWeight="Bold" FontSize="15"
                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <TabControl TabStripPlacement="Top">
                                <!-- Free Draw tab -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="12,4">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABDraw.png"
                                                   Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Free Draw" FontSize="14" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12">
                                        <Button Width="90" Height="80" CornerRadius="8" Padding="4" Cursor="Hand" BorderThickness="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Click="StartDrawAB_Click">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABLineCycle.png"
                                                       Width="36" Height="36" Stretch="Uniform"/>
                                                <TextBlock Text="AB Line" FontSize="14" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="90" Height="80" CornerRadius="8" Padding="4" Cursor="Hand" BorderThickness="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Click="StartDrawCurve_Click">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackCurve.png"
                                                       Width="36" Height="36" Stretch="Uniform"/>
                                                <TextBlock Text="Curve" FontSize="14" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="90" Height="80" CornerRadius="8" Padding="4" Cursor="Hand" BorderThickness="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Command="{Binding CreateALineFromPositionCommand}">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackAPlus.png"
                                                       Width="36" Height="36" Stretch="Uniform"/>
                                                <TextBlock Text="A+ Line" FontSize="14" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </TabItem>

                                <!-- From Boundary tab -->
                                <TabItem>
                                    <TabItem.Header>
                                        <StackPanel Spacing="2" HorizontalAlignment="Center" Margin="12,4">
                                            <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/BoundaryRecord.png"
                                                   Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Boundary" FontSize="14" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </TabItem.Header>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12">
                                        <Button Width="90" Height="80" CornerRadius="8" Padding="4" Cursor="Hand" BorderThickness="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Command="{Binding CreateTrackFromBoundaryCommand}">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABLineCycle.png"
                                                       Width="36" Height="36" Stretch="Uniform"/>
                                                <TextBlock Text="Longest" FontSize="14" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="90" Height="80" CornerRadius="8" Padding="4" Cursor="Hand" BorderThickness="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Command="{Binding CreateCurveFromBoundaryCommand}">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTrackCurve.png"
                                                       Width="36" Height="36" Stretch="Uniform"/>
                                                <TextBlock Text="Curve" FontSize="14" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Width="90" Height="80" CornerRadius="8" Padding="4" Cursor="Hand" BorderThickness="0"
                                                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                Command="{Binding CreateTracksFromAllEdgesCommand}">
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <Image Source="avares://AgValoniaGPS.Views/Assets/Icons/ABTracks.png"
                                                       Width="36" Height="36" Stretch="Uniform"/>
                                                <TextBlock Text="All Edges" FontSize="14" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>

                    <!-- DRAW MODE PANEL (replaces other panels during drawing) -->
                    <Border Grid.Column="1" x:Name="DrawModePanel" IsVisible="False"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="8">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Draw on Map" FontWeight="Bold" FontSize="18"
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                            <TextBlock x:Name="DrawInstructionText" Text="" FontSize="14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
                            <TextBlock x:Name="DrawPointCountText" Text="Points: 0" FontSize="14" FontWeight="Bold"
                                       Foreground="#1ABC9C"/>

                            <Button x:Name="FinishDrawBtn" Classes="ActionBtn" Content="Finish"
                                    Click="FinishDraw_Click" IsVisible="False" Margin="0,8,0,0"/>
                            <Button x:Name="UndoDrawBtn" Classes="FBBtn" Content="Undo Last Point"
                                    Click="UndoDraw_Click" IsVisible="False"/>
                            <Button Classes="FBBtn" Content="Cancel" Click="CancelDraw_Click"
                                    Foreground="#E74C3C"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Inline confirmation overlay (stays within Field Builder) -->
            <Border x:Name="InlineConfirmOverlay" IsVisible="False" IsHitTestVisible="True"
                    Background="#C0000000" CornerRadius="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        CornerRadius="12" Padding="24" MinWidth="320"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BoxShadow="0 8 32 #80000000">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="InlineConfirmTitle" FontSize="18" FontWeight="Bold"
                                   Foreground="#E74C3C"/>
                        <TextBlock x:Name="InlineConfirmMessage" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                            <Button Grid.Column="0" Content="No" HorizontalAlignment="Stretch" Height="40"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                    Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                    CornerRadius="6" BorderThickness="0" Cursor="Hand"
                                    Click="InlineConfirmNo_Click"/>
                            <Button Grid.Column="1" Content="Yes" HorizontalAlignment="Stretch" Height="40"
                                    Background="#E74C3C" Foreground="White"
                                    CornerRadius="6" BorderThickness="0" Cursor="Hand"
                                    Click="InlineConfirmYes_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>
            </Panel>
        </Border>
    </Grid>
</UserControl>
