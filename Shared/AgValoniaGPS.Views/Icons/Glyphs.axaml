    <!-- Flags: flagpole with triangular pennant -->
    <StreamGeometry x:Key="Glyph.Flags">M6 3 L6 21 M6 3 L18 7 L6 11</StreamGeometry>

    <!-- SnapLeft: left arrow + vertical bar at right -->
    <StreamGeometry x:Key="Glyph.SnapLeft">M2 12 L14 12 M6 8 L2 12 L6 16 M19 4 L19 20</StreamGeometry>

    <!-- SnapRight: right arrow + vertical bar at left -->
    <StreamGeometry x:Key="Glyph.SnapRight">M22 12 L10 12 M18 8 L22 12 L18 16 M5 4 L5 20</StreamGeometry>

    <!-- SnapPivot: concentric circles -->
