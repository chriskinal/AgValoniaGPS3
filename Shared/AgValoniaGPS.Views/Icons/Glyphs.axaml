    <!-- ===== BottomNavigationPanel — 12 top-level buttons ===== -->

    <!-- SkipRows: double chevron forward -->
    <StreamGeometry x:Key="Glyph.SkipRows">M3 6 L9 12 L3 18 M11 6 L17 12 L11 18</StreamGeometry>

    <!-- SectionColor: three overlapping circles -->
