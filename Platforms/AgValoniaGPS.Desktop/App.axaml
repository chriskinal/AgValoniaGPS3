<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgValoniaGPS.Desktop.App"
             xmlns:local="using:AgValoniaGPS.Desktop"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- DashboardTheme brushes live directly under Application.Resources
             (rather than included via ResourceInclude) because Avalonia's
             ThemeDictionaries lookup runs on the ResourceDictionary that
             owns them — included dictionaries lose that scoping and their
             theme-variant resolution stops working. The shared converters
             still come in via ResourceInclude below. -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ============================ DARK ============================ -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush"         Color="#0A1929"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"        Color="#132F4C"/>
                    <SolidColorBrush x:Key="CardBorderBrush"            Color="#1E4976"/>
                    <SolidColorBrush x:Key="ChromeStripBackgroundBrush" Color="#0A1929"/>
                    <SolidColorBrush x:Key="PrimaryTextBrush"           Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush"         Color="#B2BAC2"/>
                    <SolidColorBrush x:Key="LabelTextBrush"             Color="#6F7E8C"/>
                    <SolidColorBrush x:Key="AccentBrush"                Color="#66B2FF"/>
                    <SolidColorBrush x:Key="EngagedBrush"               Color="#2ECC71"/>
                    <SolidColorBrush x:Key="WarningBrush"               Color="#FF9800"/>
                    <SolidColorBrush x:Key="ErrorBrush"                 Color="#F44336"/>
                </ResourceDictionary>

                <!-- ============================ LIGHT ============================ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush"         Color="#EEF2F6"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"        Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBorderBrush"            Color="#CFD8E0"/>
                    <SolidColorBrush x:Key="ChromeStripBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PrimaryTextBrush"           Color="#1F2937"/>
                    <SolidColorBrush x:Key="SecondaryTextBrush"         Color="#4B5563"/>
                    <SolidColorBrush x:Key="LabelTextBrush"             Color="#6B7280"/>
                    <SolidColorBrush x:Key="AccentBrush"                Color="#1976D2"/>
                    <SolidColorBrush x:Key="EngagedBrush"               Color="#16A34A"/>
                    <SolidColorBrush x:Key="WarningBrush"               Color="#D97706"/>
                    <SolidColorBrush x:Key="ErrorBrush"                 Color="#DC2626"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <!-- Shared converters etc. still come in via ResourceInclude -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AgValoniaGPS.Views/Styles/SharedResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Lighter accent for better contrast on colored buttons in light mode -->
                <ColorPaletteResources x:Key="Light" Accent="#2B88D8"/>
                <ColorPaletteResources x:Key="Dark" Accent="#0078D7"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <!-- Include shared styles -->
        <StyleInclude Source="avares://AgValoniaGPS.Views/Styles/SharedStyles.axaml"/>
    </Application.Styles>
</Application>
